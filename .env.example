# Copy to .env and replace with your real values (never commit .env).

# --- Database (optional / future use) ---
DB_HOST=localhost
DB_PORT=5432

DB_USER=example_user
DB_PASSWORD=example_password_change_me
DB_NAME=example_database

# --- OpenAI ---
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Google Gemini (fallback) ---
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GEMINI_MODEL=gemini-2.0-flash

# --- Pinecone ---
PINECONE_API_KEY=pcsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PINECONE_INDEX_HEADER_BASED=nubbix-header-based
PINECONE_INDEX_FIXED_OVERLAP=nubbix-fixed-overlap
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1

# --- Embeddings (ingest + query) ---
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536


# --- Enrutado LLM (OpenAI principal, Gemini fallback) ---
# LLM_PRIMARY=openai
# LLM_FALLBACK=gemini

# --- Model call defaults (optional) ---
# OPENAI_MODEL=gpt-4o-mini
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=512
# LLM_MAX_RETRIES=3
